# Defines the Axon core library, a dynamic callback dispatch mechanism.

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//axon:build_defs/core_libs.bzl", "axon_core_libs")
load("//axon:build_defs/errors_libs.bzl", "axon_errors_libs")
load("//axon:build_defs/metrics_libs.bzl", "axon_metrics_libs")
load("//axon:build_defs/storage_libs.bzl", "axon_storage_libs")
load("//axon:build_defs/tests.bzl", "axon_tests")
load("//axon:build_defs/utils_libs.bzl", "SUPPORTED_CPP_STANDARDS", "axon_utils_config_settings", "axon_utils_libs")

package(default_visibility = ["//visibility:public"])

# Define config settings for C++ standards
axon_utils_config_settings()

# Load all library definitions
axon_utils_libs()

axon_errors_libs()

axon_metrics_libs()

axon_storage_libs()

axon_core_libs()

cc_binary(
    name = "threaded_transport_example",
    srcs = ["examples/threaded_transport_example.cpp"],
    includes = ["include"],
    target_compatible_with = select(
        {":is_cpp" + v: [] for v in SUPPORTED_CPP_STANDARDS} |
        {"//conditions:default": ["@platforms//:incompatible"]},
    ),
    deps = [
        ":axon_worker",
        "@execution-ucx//ucx_context:ucx_memory_resource_lib",
    ],
)

# Load all test definitions
axon_tests()
